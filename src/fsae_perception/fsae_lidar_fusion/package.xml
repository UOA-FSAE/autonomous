<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_lidar_fusion</name>
  <version>0.0.0</version>
  <description>Camera-LiDAR sensor fusion: refines camera cone detections using the Velodyne LiDAR.</description>
  <maintainer email="nithukrishnaa034@gmail.com">FSAE Autonomous</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>fsae_interfaces</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <depend>python3-numpy</depend>
  <!--
    NOTE: SciPy/scikit-learn are intentionally NOT depended on. The Jetson's
    system SciPy is built against NumPy 1.x but NumPy 2.x is installed, so its
    compiled extensions fail to import. All maths is implemented in pure NumPy.
  -->
  <exec_depend>python3-sensor-msgs-py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
