<?xml version="1.0"?>
<robot name="trolly">

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://trolly_description/meshes/trolly_base.stl"/>
      </geometry>
    </visual>
  </link>

  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://trolly_description/meshes/trolly_camera.stl"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.95" rpy="0 0 0"/> 
  </joint>

  <!-- ZED Camera Optical Frame (sensor frame for image data) -->
  <link name="zed_camera_optical_frame"/>
  
  <joint name="zed_camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="zed_camera_optical_frame"/>
    <!-- ZED publishes in optical frame (X-right, Y-down, Z-forward) -->
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Velodyne Lidar Frame -->
  <link name="velodyne"/>
  
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne"/>
    <!-- Position the lidar on top of the trolly -->
    <origin xyz="0.25 0 1.0" rpy="0 0 0"/>
  </joint>

</robot>