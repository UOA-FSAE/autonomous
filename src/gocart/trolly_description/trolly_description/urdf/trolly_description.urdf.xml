<?xml version="1.0"?>
<robot name="trolly">

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://trolly_description/meshes/trolly_base.stl"/>
      </geometry>
    </visual>
  </link>

  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://trolly_description/meshes/trolly_camera.stl"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.95" rpy="0 0 0"/> </joint>

</robot>