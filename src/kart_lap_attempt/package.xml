<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kart_lap_attempt</name>
  <version>0.0.1</version>
  <description>Autonomous kart lap attempt package</description>
  <maintainer email="siva.sriram1604@gmail.com">sivasriram</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS 2 Dependencies -->
  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>zed_launch</depend>
  <depend>path_planning</depend>
  <depend>stanley_controller</depend>
  <depend>CANTalk</depend>
  <exec_depend>ros2launch</exec_depend>

  <!-- Testing dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Build configuration -->
  <export>
    <build_type>ament_python</build_type> <!-- Set the correct build type -->
  </export>
</package>
